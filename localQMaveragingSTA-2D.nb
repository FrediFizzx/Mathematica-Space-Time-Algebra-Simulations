 RowBox[{"Do", "[", 
  RowBox[{"(*", 
   RowBox[{"STA", " ", "Product", " ", "Calculation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"gpc", "=", 
     RowBox[{"Grade", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"GeometricProduct", "[", 
         RowBox[{
          RowBox[{"gA", "[", 
           RowBox[{"[", "h", "]"}], "]"}], ",", 
          RowBox[{"gB", "[", 
           RowBox[{"[", "h", "]"}], "]"}]}], "]"}], "]"}], ",", "0"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pc", "[", 
      RowBox[{"[", "h", "]"}], "]"}], "=", 
     RowBox[{"Grade", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"GeometricProduct", "[", 
         RowBox[{
          RowBox[{"gA", "[", 
           RowBox[{"[", "h", "]"}], "]"}], ",", 
          RowBox[{"gB", "[", 
           RowBox[{"[", "h", "]"}], "]"}]}], "]"}], "]"}], ",", "2"}], 
      "]"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"Cross", " ", "Product", " ", "Extraction"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"a1", "=", 
     RowBox[{"aa", "[", 
      RowBox[{"[", "h", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"b1", "=", 
     RowBox[{"bb", "[", 
      RowBox[{"[", "h", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"angle", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b1", "-", "a1"}], ")"}], "/", "Degree"}], "+", "361"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"theta", "=", 
     RowBox[{"Ceiling", "[", "angle", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sumAB", "[", 
      RowBox[{"[", "theta", "]"}], "]"}], "+=", "gpc"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"countAB", "[", 
      RowBox[{"[", "theta", "]"}], "]"}], "+=", "1"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "m"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Eavg", "=", 
   RowBox[{"RotateLeft", "[", 
