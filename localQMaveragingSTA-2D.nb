    RowBox[{"\[Gamma]3", ",", "\[Gamma]0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"I4", "=", 
   RowBox[{"Pseudoscalar", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", "100000"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Number", " ", "of", " ", "trials"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bins", "=", "721"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
   "Number", " ", "of", " ", "degrees", " ", "for", " ", "averaging"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{"s2", "=", 
    RowBox[{"qpc", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "m"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", "=", 
   RowBox[{"bb", "=", 
    RowBox[{"gA", "=", 
     RowBox[{"gB", "=", 
      RowBox[{"A", "=", 
