  RowBox[{"(*", 
   RowBox[{
   "Signature", " ", "set", " ", "for", " ", "SpaceTime", " ", "Algebra"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]0", "=", 
   RowBox[{"e", "[", "1", "]"}]}], ";", 
  RowBox[{"\[Gamma]1", "=", 
   RowBox[{"e", "[", "2", "]"}]}], ";", 
  RowBox[{"\[Gamma]2", "=", 
   RowBox[{"e", "[", "3", "]"}]}], ";", 
  RowBox[{"\[Gamma]3", "=", 
   RowBox[{"e", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]1", "=", 
    RowBox[{"GeometricProduct", "[", 
     RowBox[{"\[Gamma]1", ",", "\[Gamma]0"}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"SpaceTime", " ", "Bivectors"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]2", "=", 
   RowBox[{"GeometricProduct", "[", 
