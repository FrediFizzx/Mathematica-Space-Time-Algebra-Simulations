          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "m"}], "]"}]}]}]}]}]}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sumAB", "=", 
   RowBox[{"countAB", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", "bins"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phi", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"GeometricProduct", "[", 
        RowBox[{"I4", ",", "\[Sigma]2"}], "]"}]}], ")"}]}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"STA", " ", "Particle", " ", "Wavefuncion"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
