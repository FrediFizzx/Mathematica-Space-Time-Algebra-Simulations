Cell[TextData[{
 StyleBox["Supplemental Material for  \[OpenCurlyDoubleQuote]Beyond Quantum \
Mechanics: Local QM SpaceTime\nAlgebra Prediction of the Singlet State\
\[CloseCurlyDoubleQuote] \nValidation of the Local QM Product Calculation \
Prediction replacing Pauli Matrices \nwith SpaceTime Algebra and 2D Vectors, \
Based on Joy Christian\[CloseCurlyQuote]s 3-Sphere Model.\n",
  FontSize->14,
  FontColor->GrayLevel[0]],
 StyleBox[ButtonBox["T",
